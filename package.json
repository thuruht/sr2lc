{
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite --port 3000",
    "dev:backend": "wrangler dev worker/index.tsx --port 8787",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:setup": "wrangler d1 execute sr2lc-db --file=worker/schema.sql"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^8.1.3",
    "hono": "^4.10.4",
    "quill": "^2.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-masonry-css": "^1.0.16",
    "react-medium-image-zoom": "^5.4.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.22.3",
    "react-share": "^5.2.2",
    "yet-another-react-lightbox": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.2.1",
    "bcryptjs": "^2.4.3",
    "npm-run-all": "^4.1.5",
    "vite": "^6.3.5",
    "wrangler": "^4.17.0"
  }
}
